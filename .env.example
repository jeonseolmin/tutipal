# 복사해서 사용: cp .env.example .env   (.env 는 절대 커밋하지 않기, .gitignore 에 있음)
# 팀원은 각자 자기 PC 에서 서버를 띄워 개발한다. 아래 ①은 각자 정하고, ②는 그대로, ③만 팀에서 받는다.

# ══ ① 각자 정하는 비밀값 (아무 랜덤 문자열, 팀원끼리 같을 필요 없음) ══════════════
# 만들기: python -c "import secrets; print(secrets.token_hex(32))"
# 주의: DB 를 한 번 띄운 뒤 POSTGRES_PASSWORD 를 바꾸면 접속 안 됨 → docker compose down -v 로 DB 를 지우고 다시
POSTGRES_PASSWORD=change-me-db-password
REDIS_PASSWORD=change-me-redis-password
# Spring ↔ FastAPI 내부 통신 키
AI_INTERNAL_KEY=change-me-internal-key
# 화면공유 입장권(JWT) 서명 키. 32자 이상
LIVEKIT_API_SECRET=change-me-livekit-secret-at-least-32-characters

# ══ ② 개발할 때는 그대로 ═══════════════════════════════════════════════════
# 앱 · 브라우저가 여는 서버 주소. 공개 시연(팀장 PC)은 https://<서브도메인>
APP_BASE_URL=http://localhost

POSTGRES_DB=tutipal
POSTGRES_USER=tutipal
# 이 PC 에서 DB 에 직접 붙을 포트 (127.0.0.1 에만 열림). 이미 PostgreSQL 이 5433 을 쓰면 바꾸기
DB_HOST_PORT=5433

# LLM: 지금은 ollama 만 (외부 API 공급자는 아직 없음, 501)
LLM_PROVIDER=ollama
# Ollama 주소. 같은 PC 면 그대로, GPU 가 약하면 팀장 PC 의 Ollama 주소(Tailscale IP)로
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 처음 한 번: ollama pull gemma3:12b (약 8GB, GPU 12GB 권장) · ollama pull bge-m3 (약 1.2GB)
OLLAMA_MODEL=gemma3:12b
# 임베딩 (자료 RAG · 복습 묶기). 2026-11-16 결정 bge-m3. 바꾸면 기존 벡터를 다시 만들어야 함
EMBEDDING_MODEL=bge-m3

# 화면공유 (LiveKit). 공개 시연 때는 PUBLIC_URL · NODE_IP 를 팀장 PC 의 Tailscale IP 등으로 (이슈 #5)
LIVEKIT_API_KEY=tutipal
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_NODE_IP=127.0.0.1

# 개발용 로그인: 내 PC 에서는 true 로 바꾸면 소셜 키 없이 "개발용 로그인" 으로 시험 가능.
# 공개 서버(팀장 PC 시연)에서는 반드시 false (켜 두면 누구나 테스트 계정으로 들어옴)
DEV_LOGIN=false

# ══ ③ 팀에서 받는 값: 소셜 로그인 키 (발급 전에는 그대로 두고 개발용 로그인 사용) ══════
# 저장소에 올리지 말고 메신저 등으로 받기 (공개 저장소). 발급 · 등록은 이슈 #4
# Redirect URI (각 콘솔에 등록): {APP_BASE_URL}/login/oauth2/code/{google|naver|kakao}
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
# Naver: https://developers.naver.com/apps
NAVER_CLIENT_ID=change-me
NAVER_CLIENT_SECRET=change-me
# Kakao: https://developers.kakao.com  (REST API 키 = CLIENT_ID, 보안 > Client Secret 활성화)
KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me
