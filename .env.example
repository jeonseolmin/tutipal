# 복사해서 사용: cp .env.example .env   (.env 는 절대 커밋하지 않기)

# ── 서비스 주소 ─────────────────────────────────────
# 로컬: http://localhost   /  배포: https://class.example.com (구매한 서브도메인)
APP_BASE_URL=http://localhost
DOMAIN=localhost

# ── PostgreSQL (+ pgvector) ─────────────────────────
POSTGRES_DB=tutipal
POSTGRES_USER=tutipal
POSTGRES_PASSWORD=change-me-db-password

# ── 로컬 개발용 호스트 포트 (127.0.0.1 에만 열림, 이미 쓰는 포트와 겹치면 변경) ──
DB_HOST_PORT=5433

# ── Redis (로그인 세션 · WebSocket pub/sub) ─────────
REDIS_PASSWORD=change-me-redis-password

# ── Spring ↔ FastAPI 내부 통신 키 (openssl rand -hex 32) ──
AI_INTERNAL_KEY=change-me-internal-key

# ── LLM 공급자: api | ollama  (실패 시 다른 쪽으로 폴백) ──
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# EC2 밖(GPU PC 등)의 Ollama 주소. 같은 PC면 http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:12b
# 임베딩: Ollama 모델 (자료 RAG · 복습 묶기). 2026-11-16 결정 bge-m3 (KURE-v1 의 바탕), 바꾸면 기존 벡터 다시 만들어야 함
EMBEDDING_MODEL=bge-m3

# ── 소셜 로그인 (OAuth2) ────────────────────────────
# Redirect URI (각 콘솔에 등록): {APP_BASE_URL}/login/oauth2/code/{google|naver|kakao}

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Naver: https://developers.naver.com/apps
NAVER_CLIENT_ID=change-me
NAVER_CLIENT_SECRET=change-me

# Kakao: https://developers.kakao.com  (REST API 키 = CLIENT_ID, 보안 > Client Secret 활성화)
KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me

# ── 개발용 로그인 (소셜 키 없이 로컬 테스트) ─────────
# true 면 로그인 화면에 "개발용 로그인" 이 동작. 공개 서버에서는 절대 true 로 두지 말 것
DEV_LOGIN=false

# ── 화면공유 (LiveKit, docker-compose 의 livekit) ────
# 키/시크릿: 시크릿은 32자 이상 (openssl rand -hex 32). 입장권(JWT)은 Spring 이 이 값으로 서명
LIVEKIT_API_KEY=tutipal
LIVEKIT_API_SECRET=change-me-livekit-secret-at-least-32-characters
# 앱/브라우저가 접속하는 LiveKit 주소. 로컬 ws://localhost:7880, Tailscale 이면 ws://<팀장PC Tailscale IP>:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# LiveKit 이 영상 연결용으로 알려 주는 이 PC 의 IP (로컬 127.0.0.1, Tailscale 이면 그 IP)
LIVEKIT_NODE_IP=127.0.0.1
